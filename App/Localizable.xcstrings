          }
        }
      }
    },
    "Usa la resolución completa de tu pantalla: más nítido, pero los programas se ven a la mitad de tamaño. Combínalo con una escala de 192 DPI.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses your screen's full resolution: sharper, but programs appear at half size. Combine it with a scale of 192 DPI."
          }
        }
      }
    },
