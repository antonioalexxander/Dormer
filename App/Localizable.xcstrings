    "DPI": {
      "extractionState": "manual",
      "shouldTranslate": false
    },
    "DXMT no está disponible con este motor Wine. Algunas apps modernas que piden Direct3D 11 real (por ejemplo Audacity 4) no abrirán.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT is not available with this Wine engine. Some modern apps that need real Direct3D 11 (for example Audacity 4) will not open."
          }
        }
      }
    },
    "DXMT no funciona con el motor «%@»: Dormer no tiene un controlador de pantalla compatible para él. Elige WineD3D.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT doesn't work with the “%@” engine: Dormer has no compatible display driver for it. Choose WineD3D."
          }
        }
      }
    },
